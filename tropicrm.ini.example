# TropiCRM server configuration.
#
# Copy to tropicrm.ini and pass it with --config. Every key is optional; the
# values shown are the built-in defaults. Environment variables override the
# file: TROPICRM_<SECTION>_<KEY>, e.g. TROPICRM_SERVER_PORT=9000.

[server]
host = 0.0.0.0
port = 8080
# Worker threads handling connections.
workers = 16
max_body_bytes = 10485760
max_header_bytes = 65536
# Requests served on one keep-alive connection before it is closed.
keepalive_requests = 100

[data]
# One directory per org is created under <dir>/orgs. Set to "" for an
# in-memory server that forgets everything on exit.
dir = ./data
# Compact an org's write-ahead log into a snapshot after this many entries.
snapshot_every = 5000

[auth]
token_ttl_seconds = 7200
refresh_ttl_days = 30
pbkdf2_iterations = 100000
max_failed_logins = 5
lockout_minutes = 15
password_reset_ttl_minutes = 60

[limits]
# Per client address, for login, password reset, signup and web forms.
public_requests_per_minute = 30

[webhooks]
workers = 2
timeout_ms = 5000
max_attempts = 10

[cors]
# Comma-separated list of origins allowed to call the API from a browser.
allowed_origins =

[log]
# debug, info, warn, error or off
level = info
# Empty means standard error.
file =
requests = true

[platform]
# SHA-256 (hex) of the key accepted in X-Platform-Admin-Key. Generate it with
#   tropicrm-admin hash-key <key>
# Empty disables the platform admin API.
admin_key_sha256 =
# Allow anyone to create an org through POST /services/signup.
signup_enabled = true
